# ===========================================
# 금융 AI 에이전트 시스템 - 환경 변수 템플릿
# ===========================================

# LLM 설정
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
LLM_PROVIDER=anthropic  # anthropic, openai, azure, vllm, ollama
MODEL_NAME=claude-3-5-sonnet-20241022

# vLLM 설정 (자체 호스팅)
VLLM_API_BASE=http://localhost:8001/v1
VLLM_MODEL_NAME=meta-llama/Llama-3-70b-chat-hf
VLLM_API_KEY=  # optional

# Ollama 설정 (로컬)
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_MODEL_NAME=llama3:70b

# 데이터베이스
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finance_agent
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=change_this_password

# Redis 캐시
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_this_password
REDIS_DB=0

# 벡터 데이터베이스 (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=change_this_api_key
QDRANT_COLLECTION=finance_documents

# JWT 인증
JWT_SECRET_KEY=change_this_to_random_256_bit_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 암호화 설정
ENCRYPTION_KEY=change_this_to_32_byte_key  # AES-256용
DATA_ENCRYPTION_ALGORITHM=AES-256-GCM

# HashiCorp Vault (프로덕션 환경)
VAULT_ADDR=https://vault.example.com:8200
VAULT_TOKEN=change_this_vault_token
VAULT_NAMESPACE=finance_agents

# 감사 로깅
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=/var/log/finance-agent/audit
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# API 보안
API_RATE_LIMIT_PER_MINUTE=60
API_CORS_ORIGINS=https://app.example.com
API_KEY_ROTATION_DAYS=90

# 규제 준수
GDPR_ENABLED=true
DATA_RETENTION_DAYS=2555  # 7년 (금융 규제)
PII_ANONYMIZATION=true

# 모니터링
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# 개발 환경
ENVIRONMENT=development  # development, staging, production
DEBUG_MODE=false
